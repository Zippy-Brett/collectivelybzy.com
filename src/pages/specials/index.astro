---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSpecials } from '../../lib/content';

const specials = await getSpecials();
---

<BaseLayout title="Store specials — Collectively Bzy" description="New products and store specials from Collectively Bzy.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Store notes</div><h1>New things on the shelf.</h1><p>Small finds, seasonal updates, and the occasional good surprise.</p></div></section>
  <section class="section"><div class="container"><div class="grid two">{specials.length === 0 && <article class="store-empty"><div class="eyebrow">Nothing on the shelf just yet</div><h2>Good things, in their own time.</h2><p>We’ll share new finds here when they’re ready. Have something in mind?</p><a class="button" href="mailto:hello@collectivelybzy.com">Say hello ↗</a></article>}{specials.map((special) => <article class="card" style={`--accent: var(--${special.accent})`}><div><div class="eyebrow">{special.eyebrow}</div><h2 class="card-title">{special.title}</h2><p class="card-copy">{special.description}</p></div><div class="card-footer"><span class="status">{special.timing}</span><a class="button" href={special.url}>{special.cta}</a></div></article>)}</div></div></section>
</BaseLayout>
