---
import ProductVisuals from '../../components/ProductVisuals.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---
<BaseLayout title={`${item.title} — Collectively Bzy`} description={item.description}>
  <section class="detail-hero">
    <div class="container">
      <a class="detail-back" href="/projects/">← All projects</a>
      <div class="eyebrow">{item.eyebrow}</div>
      <h1>{item.title}</h1>
      <p>{item.description}</p>
      <div class="detail-meta">
        {item.status && <span class="status detail-status">{item.status}</span>}
        {item.tags?.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ProductVisuals item={item}/>
      <div class="prose">
        <p><span class="script">A project note:</span> {item.longDescription ?? item.description}</p>
        {item.embeds?.length && <div class="embed-stack" aria-label={`${item.title} players`}>
          {item.embeds.map((embed) => {
            const url = new URL(embed.url);
            const isApprovedSunoEmbed = url.protocol === 'https:' && url.hostname === 'suno.com' && url.pathname.startsWith('/embed/');
            return isApprovedSunoEmbed && <figure class="embed-card">
              <figcaption>{embed.title}</figcaption>
              <iframe src={url.toString()} title={`Suno player: ${embed.title}`} loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </figure>;
          })}
        </div>}
        {item.features?.length && <ul class="feature-list">{item.features.map(feature=><li>{feature}</li>)}</ul>}
        <blockquote>Make something small enough to finish, and strange enough to remember.</blockquote>
      </div>
    </div>
  </section>
</BaseLayout>
