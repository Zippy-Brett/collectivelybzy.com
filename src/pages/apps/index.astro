---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getApps } from '../../lib/content';
const apps = await getApps();
---
<BaseLayout title="Everyday apps & works in progress — Collectively Bzy" description="Explore nine independent app projects from Collectively Bzy, from private travel journals and care logs to creative tools in testing.">
<section class="page-hero"><div class="container"><div class="eyebrow">The app collection</div><h1>A little help.<br/>A lot of possibility.</h1><p>Independent tools for the everyday, each with its own purpose and a little personality.</p></div></section>
{[{label:'Available on the App Store',items:apps.filter(a=>!!a.storeUrl)}, {label:'In testing',items:apps.filter(a=>!a.storeUrl)}].map(group=><section class="section"><div class="container"><div class="section-head"><h2>{group.label}</h2><p>{group.items.length} apps · Find the one that fits your day.</p></div><div class:list={['grid app-grid',group.label === 'Available on the App Store' && 'released-grid']}>{group.items.map(item=><Card item={item}/>)}</div></div></section>)}
<Newsletter/>
</BaseLayout>
