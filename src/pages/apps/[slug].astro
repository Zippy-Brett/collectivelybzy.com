---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getApps } from '../../lib/sanity';

export async function getStaticPaths() {
  const apps = await getApps();
  return apps.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.title} — Collectively Bzy`} description={item.description}>
  <section class="detail-hero"><div class="container"><div class="eyebrow">{item.eyebrow}</div><h1>{item.title}</h1><p>{item.description}</p><div class="detail-meta">{item.tags?.map((tag) => <span class="tag">{tag}</span>)}</div></div></section>
  <section class="section"><div class="container">{item.image && <img class:list={['detail-image', item.imageFit === 'contain' && 'image-contain']} src={item.image} alt={item.imageAlt ?? `Product image for ${item.title}`} />}{item.gallery && <div class="detail-gallery">{item.gallery.map((image) => <img class="detail-gallery-image" src={image.src} alt={image.alt} loading="lazy" />)}</div>}<div class="prose"><p><span class="script">A studio note:</span> {item.longDescription ?? item.description}</p><h2>Made to make care easier to carry.</h2>{item.features && <ul class="feature-list">{item.features.map((feature) => <li>{feature}</li>)}</ul>}{item.notice && <aside class="notice"><strong>A note about the app</strong><p>{item.notice}</p></aside>}<div class="button-row">{item.storeUrl && <a class="store-badge" href={item.storeUrl} target="_blank" rel="noreferrer"><img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83" alt="Download on the App Store" /></a>}<a class="button secondary-dark" href="/support/">Find support</a></div></div></div></section>
</BaseLayout>
