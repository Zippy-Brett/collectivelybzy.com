---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlueVelocity from '../../components/BlueVelocity.astro';
import { getGames } from '../../lib/sanity';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<BaseLayout title={`${item.title} — Collectively Bzy`} description={item.description} theme="play">
  <section class="detail-hero"><div class="container"><div class="eyebrow">{item.eyebrow}</div><h1>{item.title}</h1><p>{item.description}</p><div class="detail-meta">{item.tags?.map((tag) => <span class="tag">{tag}</span>)}</div><a class="button" href="#game-area">{item.slug === 'blue-velocity' ? 'Start the run' : 'Play area coming soon'}</a></div></section>
  {item.slug === 'blue-velocity' ? <section class="section" id="game-area"><div class="container"><BlueVelocity /></div></section> : <section class="section" id="game-area"><div class="container"><div class="prose"><p><span class="script">A play note:</span> Approved game packages will load here inside an isolated, sandboxed game area. The curator can feature or hide a game; only the owner can approve its package or origin.</p><h2>Small rules, big feelings.</h2><p>This template leaves room for instructions, credits, controls, and a safe embedded play surface without exposing the main site or CMS to game code.</p></div></div></section>}
</BaseLayout>
