---
import ProductVisuals from '../../components/ProductVisuals.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlueVelocity from '../../components/BlueVelocity.astro';
import { getGames } from '../../lib/content';

export async function getStaticPaths() {
  const games = await getGames();
  return games.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const isApprovedLocalGame = typeof item.gameUrl === 'string' && /^(\/games\/|\/game-packages\/)/.test(item.gameUrl);
---

<BaseLayout title={`${item.title} — Collectively Bzy`} description={item.description} theme="play">
  <section class="detail-hero"><div class="container"><div class="eyebrow">{item.eyebrow}</div><h1>{item.title}</h1><p>{item.description}</p><div class="detail-meta">{item.tags?.map((tag) => <span class="tag">{tag}</span>)}</div><a class="button" href="#game-area">{item.slug === 'blue-velocity' || isApprovedLocalGame ? 'Play the game' : 'Play area coming soon'}</a></div></section>
  {item.slug === 'blue-velocity' ? <section class="section" id="game-area"><div class="container"><BlueVelocity /></div></section> : isApprovedLocalGame ? <section class="section" id="game-area"><div class="container"><div class="game-frame-wrap"><iframe class="game-frame" src={item.gameUrl} title={`${item.title} playable game`} loading="lazy" sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe></div><p class="game-safety-note">A small game for a little time out. Jump in and see where it takes you.</p></div></section> : <section class="section" id="game-area"><div class="container"><div class="prose"><div class="eyebrow">On the workbench</div><h2>A little more time to play.</h2><p>This game is still taking shape. Explore the play room for something you can try today.</p><a class="button" href="/games/">Back to the play room ↗</a></div></div></section>}
  {(item.image || item.gallery?.length || item.features?.length) && <section class="section"><div class="container"><ProductVisuals item={item}/>{item.features?.length && <ul class="feature-list">{item.features.map(feature=><li>{feature}</li>)}</ul>}</div></section>}
</BaseLayout>
