---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Newsletter from '../components/Newsletter.astro';
import { getApps, getGames, getProjects, getStudioHome } from '../lib/content';
const [apps, games, projects, home] = await Promise.all([getApps(), getGames(), getProjects(), getStudioHome()]);
const released = apps.filter(app => !!app.storeUrl);
const testing = apps.filter(app => !app.storeUrl);
const featured = apps.find(app => app.slug === home.featured_app);
---
<BaseLayout>
  <section class="studio-hero container">
    <div class="hero-copy"><div class="eyebrow"><span class="live-dot"></span> A small independent creative studio</div>
      <h1>{home.headline}<br/><span>{home.second_line}</span></h1>
      <p>{home.description}</p>
      <div class="button-row"><a class="button" href="/apps/">Find your next useful thing <span aria-hidden="true">↗</span></a><a class="text-link" href="#workbench">Explore the workbench ↓</a></div>
      <div class="hero-footnote"><span>Made with care. A little curiosity, too.</span><span class="tiny-bee" aria-hidden="true">✳</span></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="art-label label-one">A little useful.</span><img src="/images/collectively-bzy-bee.webp" alt="" fetchpriority="high"/><span class="art-label label-two">A little unexpected.</span><span class="art-star">✳</span><span class="art-caption">KEEP CURIOUS · COLLECTIVELY BZY</span></div>
  </section>
  <div class="studio-strip"><div class="container"><span>TOOLS FOR REAL LIFE</span><span aria-hidden="true">✳</span><span>ROOM FOR PLAY</span><span aria-hidden="true">✳</span><span>IDEAS IN MOTION</span></div></div>
  {featured && <section class="section"><div class="container feature-spotlight"><div class="spotlight-copy"><div class="eyebrow">A closer look / {featured.title}</div><h2>{featured.slug === 'roametry' ? <>Go somewhere.<br/>Keep the feeling.</> : featured.title}</h2><p>{featured.description}</p><a class="button" href={`/apps/${featured.slug}/`}>Meet {featured.title} ↗</a><span class="spotlight-note">Your memories. Your own little world.</span></div><a class="spotlight-art" href={`/apps/${featured.slug}/`} aria-label={`Explore ${featured.title}`}><img src={featured.image} alt={featured.imageAlt} loading="lazy"/></a></div></section>}
  <section class="section app-section" id="apps"><div class="container"><div class="section-head"><div><div class="eyebrow">Out in the world / {released.length} apps</div><h2>Find your everyday companion.</h2></div><p>For the things you care about: your people, your plans, your privacy, and your peace of mind.</p></div><div class="grid app-grid released-grid">{released.map(item => <Card item={item}/>)}</div></div></section>
  <section class="section testing-section" id="workbench"><div class="container"><div class="section-head"><div><div class="eyebrow">On the workbench / {testing.length} apps</div><h2>Good ideas take a little time.</h2></div><p>A peek at what we’re testing. Follow the studio for release news as each idea finds its feet.</p></div><div class="grid app-grid">{testing.map(item => <Card item={item}/>)}</div></div></section>
  <section class="section dark"><div class="container"><div class="section-head"><div><div class="eyebrow">The play room</div><h2>Take the scenic route.</h2></div><p>Small games. Creative experiments. Just enough room to get a little distracted.</p></div><div class="grid two">{games.slice(0,2).map(item => <Card item={item} dark/>)}</div><a class="text-link" href="/games/">All games & experiments ↗</a></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Beyond the apps</div><h2>There’s more where that came from.</h2></div><a class="text-link" href="/projects/">Explore projects ↗</a></div><div class="grid two">{projects.map(item => <Card item={item}/>)}</div><div class="store-note"><span>Small finds & seasonal notes.</span><a href="/specials/">From the store ↗</a></div></div></section>
  <Newsletter/>
</BaseLayout>
