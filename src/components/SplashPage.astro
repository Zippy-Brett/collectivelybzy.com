  </g>
</svg>

  <button class="bzy-splash__skip" type="button" data-skip-splash>Skip intro <span aria-hidden="true">↗</span></button>
</div>

<script>
  import { gsap } from 'gsap';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(MotionPathPlugin);

  let dispose: (() => void) | undefined;

  function mountSplash() {
    const overlay = document.querySelector<HTMLElement>('[data-bzy-splash]');
    if (!overlay || overlay.dataset.started) return;
    dispose?.();
    overlay.dataset.started = 'true';

    // The long-form mark is a welcome, not a loading screen. Show it once per
    // browser session so returning visitors land on the actual site quickly.
    // The no-index preview route can always replay it for review.
    const seenKey = 'collectively-bzy-splash-seen-v1';
    let seenThisSession = false;
    try {
      seenThisSession = window.sessionStorage.getItem(seenKey) === '1';
    } catch {
      // Storage can be unavailable in privacy modes; the intro still works.
    }
    if (seenThisSession && overlay.dataset.bzySplashForce !== 'true') {
      overlay.remove();
      return;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Hidden by default: without JavaScript, visitors immediately get the website.
    if (reduceMotion.matches) {
      overlay.remove();
      return;
    }

    const svg = overlay.querySelector<SVGSVGElement>('svg');
    const bee1 = overlay.querySelector<SVGGElement>('#bee1');
    const bee2 = overlay.querySelector<SVGGElement>('#bee2');
    const skip = overlay.querySelector<HTMLButtonElement>('[data-skip-splash]');
    const text = overlay.querySelector<SVGPathElement>('#textPath');
    const textDetails = overlay.querySelector<SVGPathElement>('#textDetailsPath');
    const subText = overlay.querySelector<SVGPathElement>('#subTextPath');
    if (!svg || !bee1 || !bee2 || !skip || !text || !textDetails || !subText) return;

    // Move outside transformed parents, which can otherwise contain a fixed overlay.
    document.body.append(overlay);
    const previousFocus = document.activeElement;
    const previousOverflow = document.documentElement.style.overflow;
    const inertElements: Array<[HTMLElement, boolean]> = [];
    let timeline: gsap.core.Timeline | undefined;
    let flutter: gsap.core.Tween | undefined;
    let watchdog = 0;
    let finished = false;

    function finish() {
      if (finished) return;
      finished = true;
      window.clearTimeout(watchdog);
      timeline?.kill();
      flutter?.kill();
      inertElements.forEach(([element, wasInert]) => { element.inert = wasInert; });
      document.documentElement.style.overflow = previousOverflow;
      document.removeEventListener('keydown', onKeyDown);
      reduceMotion.removeEventListener('change', onMotionChange);
      if (document.activeElement === skip && previousFocus instanceof HTMLElement && previousFocus !== document.body && previousFocus.isConnected) {
        previousFocus.focus({ preventScroll: true });
      }
      try {
        window.sessionStorage.setItem(seenKey, '1');
      } catch {
        // Nothing to do; the next navigation may show the intro again.
      }
      overlay?.remove();
    }

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === 'Escape') finish();
    }
    function onMotionChange() {
      if (reduceMotion.matches) finish();
    }

    dispose = finish;
    skip.addEventListener('click', finish, { once: true });
    document.addEventListener('keydown', onKeyDown);
    reduceMotion.addEventListener('change', onMotionChange);

    try {
      type Stroke = { path: SVGPathElement; length: number; start: DOMPoint; end: DOMPoint; fillOpacity: number };

      // A new M is a real pen lift. Split it so dash offsets never reset on
      // disconnected subpaths and the bee flies between strokes without drawing.
      function prepare(source: SVGPathElement): Stroke[] {
        const parts = (source.getAttribute('d') || '').trim().split(/(?=M)/).filter(Boolean);
        if (parts.length > 1) source.setAttribute('visibility', 'hidden');
        return parts.map((d) => {
          const path = parts.length === 1 ? source : source.cloneNode(false) as SVGPathElement;
          if (path !== source) {
            path.removeAttribute('id');
            path.removeAttribute('visibility');
            path.setAttribute('d', d.trim());
            // Preserve the original paint order so body stripes stay behind wings.
            source.parentNode?.insertBefore(path, source);
          }
          const length = path.getTotalLength();
          const fill = path.getAttribute('fill');
          const fillOpacity = fill && fill !== 'none' ? Number(path.getAttribute('fill-opacity') ?? 1) : 0;
          gsap.set(path, { strokeDasharray: `${length} ${length}`, strokeDashoffset: length, fillOpacity: 0, opacity: 0 });
          return { path, length, start: path.getPointAtLength(0), end: path.getPointAtLength(length), fillOpacity };
        });
      }

      const hiveStrokes = ['#hivePath', '#markBodyPath', '#markStripesPath', '#markHeadPath', '#markDetailsPath', '#markEyePath', '#rearUpperWingPath', '#rearLowerWingPath', '#markWingsPath', '#markWingAccentPath', '#petalLeftPath', '#petalRightPath', '#petalStemPath']
        .flatMap((selector) => {
          const path = overlay.querySelector<SVGPathElement>(selector);
          return path ? prepare(path) : [];
        });
      const wordStrokes = prepare(text);
      const detailStrokes = prepare(textDetails);
      const subStrokes = prepare(subText);
      if (!hiveStrokes.length || !wordStrokes.length || !subStrokes.length) {
        finish();
        return;
      }

      gsap.set([bee1, bee2], { svgOrigin: '0 0', opacity: 0 });
      overlay.querySelector('#flightHeads')?.removeAttribute('visibility');
      overlay.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      Array.from(document.body.children).forEach((child) => {
        if (child instanceof HTMLElement && child !== overlay && !['SCRIPT', 'STYLE', 'LINK'].includes(child.tagName)) {
          inertElements.push([child, child.inert]);
          child.inert = true;
        }
      });
      skip.focus({ preventScroll: true });
      watchdog = window.setTimeout(finish, 16000);
      flutter = gsap.to(overlay.querySelectorAll('.bee-wings'), {
        scaleY: 0.45, transformOrigin: '50% 100%', duration: 0.075,
        repeat: -1, yoyo: true, ease: 'sine.inOut', stagger: 0.035,
      });
      timeline = gsap.timeline({ onComplete: finish });
      const flight = timeline;

      // Every flight uses this SVG's own coordinates. The bee's stinger at (0,0)
      // follows the exact path endpoint; no bounding-box alignment is required.
      function fly(bee: SVGGElement, d: string, duration: number, at: number, ease = 'none', autoRotate = true) {
        flight.to(bee, {
          motionPath: { path: d, autoRotate }, duration, ease,
        }, at);
      }

      function draw(bee: SVGGElement, strokes: Stroke[], at: number, speed: number, from: { x: number; y: number }, entering = false) {
        let cursor = at;
        let point = from;
        strokes.forEach((stroke, index) => {
          const distance = Math.hypot(stroke.start.x - point.x, stroke.start.y - point.y);
          if (distance > 0.5) {
            const lift = index === 0 && entering ? 0.62 : gsap.utils.clamp(0.12, 0.32, distance / 900);
            const bend = Math.min(38, distance * 0.18);
            const bridge = `M${point.x} ${point.y} C${point.x + distance * 0.2} ${point.y - bend} ${stroke.start.x - distance * 0.2} ${stroke.start.y - bend} ${stroke.start.x} ${stroke.start.y}`;
            flight.to(bee, { opacity: 1, duration: 0.16 }, cursor);
            fly(bee, bridge, lift, cursor, 'power1.inOut');
            cursor += lift;
          }
          const duration = Math.max(0.10, stroke.length / speed);
          flight.set(stroke.path, { opacity: 1 }, cursor);
          flight.to(stroke.path, { strokeDashoffset: 0, duration, ease: 'none' }, cursor);
          fly(bee, stroke.path.getAttribute('d')!, duration, cursor);
          if (stroke.fillOpacity > 0) {
            flight.to(stroke.path, { fillOpacity: stroke.fillOpacity, duration: 0.32, ease: 'sine.out' }, cursor + duration);
          }
          cursor += duration;
          point = stroke.end;
        });
        return { at: cursor, point };
      }

      // Both entrances begin beyond the viewport at every aspect ratio.
      const unit = svg.getScreenCTM()?.a || 1;
      const farX = 850 + window.innerWidth / unit;
      // Bee 1 draws the hexagon, colored bee, and small botanical accents.
      const hive = draw(bee1, hiveStrokes, 0, 850, { x: -farX, y: 112 }, true);
      // Bee 2 starts just after the honeycomb itself is drawn, overlapping Bee 1.
      const word = draw(bee2, wordStrokes, 0.62 + hiveStrokes[0].length / 850 + 0.08, 900, { x: farX, y: 415 }, true);
      const details = draw(bee2, detailStrokes, word.at, 440, word.point);
      const sub = draw(bee2, subStrokes, details.at, 560, details.point);
      const landAt = Math.max(hive.at, sub.at) + 0.20;
      overlay.dataset.phase = 'drawing';
      flight.call(() => { overlay.dataset.phase = 'landing'; }, [], landAt);

      // Feet average (23,12) in bee-local coordinates. Position them on the
      // crowns of C and B, with a short hover before the last five-unit descent.
      function land(bee: SVGGElement, from: { x: number; y: number }, perch: { x: number; y: number }, at: number) {
        const x = perch.x - 23;
        const y = perch.y - 12;
        const approach = `M${from.x} ${from.y} C${from.x - 65} ${from.y - 65} ${x - 40} ${y - 48} ${x} ${y - 5}`;
        fly(bee, approach, 0.90, at, 'power2.inOut', false);
        flight.to(bee, { rotation: 0, duration: 0.55, ease: 'power2.out' }, at);
        flight.to(bee.querySelector('.bee-legs'), { opacity: 1, duration: 0.20 }, at + 0.70);
        flight.to(bee, { y, duration: 0.22, ease: 'sine.out' }, at + 0.90);
      }

      land(bee1, hive.point, { x: 124.7, y: 412.92 }, landAt);
      land(bee2, sub.point, { x: 591.3, y: 405.28 }, landAt + 0.10);
      const restingAt = landAt + 1.22;
      flight.call(() => {
        flutter?.pause();
        overlay.dataset.phase = 'resting';
      }, [], restingAt);
      flight.to(overlay.querySelectorAll('.bee-wings'), {
        scaleY: 1, duration: 0.20, ease: 'sine.out',
      }, restingAt);
      // Let both bees rest on the wordmark before revealing the website.
      flight.to(overlay, { opacity: 0, duration: 0.65, ease: 'power2.inOut' }, restingAt + 1.40);
    } catch (error) {
      console.warn('The splash could not start; showing the website.', error);
      finish();
    }
  }

  // Works with ordinary Astro pages and Astro's client-side navigation.
  document.addEventListener('astro:page-load', mountSplash);
  document.addEventListener('astro:before-swap', () => dispose?.());
  mountSplash();
</script>

<style>
  .bzy-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: grid;
    place-items: center;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    isolation: isolate;
    background: #1b2c30;
    color: #f7e5bd;
  }
  .bzy-splash[hidden] { display: none; }
  .bzy-splash__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 50% 44%, #55746b28, transparent 62%),
      radial-gradient(ellipse at 20% 90%, #d5a84b12, transparent 52%);
  }
  .bzy-splash__logo {
    display: block;
    width: min(94vw, 880px, 115vh);
    width: min(94vw, 880px, 115dvh);
    height: auto;
    overflow: visible;
  }
  .bzy-splash__skip {
    position: absolute;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    border: 1px solid #f7e5bd38;
    border-radius: 999px;
    padding: 0.75rem 1.05rem;
    font: 500 0.8rem/1.2 system-ui, sans-serif;
    color: #f7e5bd;
    background: #1b2c30e6;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .bzy-splash__skip span { margin-left: 0.65rem; color: #edc463; }
  .bzy-splash__skip:hover { background: #2b4246; }
  .bzy-splash__skip:focus-visible { outline: 2px solid #edc463; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .bzy-splash { display: none; }
  }
</style>
