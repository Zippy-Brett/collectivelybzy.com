      <path fill="#e9ae47" d="M7 0 C9 -8 26 -10 32 -4 C39 2 29 10 17 8 C10 7 7 3 7 0" />
      <path stroke="#1b2c30" stroke-width="2.6" d="M15 -7 Q12 0 15 7 M23 -7 Q20 1 23 8" />
      <g class="bee-wings" fill="#f7e7bf" fill-opacity="0.9" stroke="#f8eac9" stroke-width="1.4">
        <path d="M20 -5 C7 -11 5 -25 15 -24 C24 -23 27 -12 20 -5" />
        <path d="M22 -5 C24 -18 38 -25 40 -17 C42 -9 31 -4 22 -5" />
      </g>
      <path d="M31 -4 Q32 -12 38 -13 M30 -5 Q26 -13 30 -16" />
      <path stroke="#1b2c30" d="M32 0 L32.6 0" stroke-width="2.5" />
      <path class="bee-legs" opacity="0" stroke-width="1.25" d="M15 6 L13 12 L18 12 M25 6 L23 12 L28 12" />
    </g>

    <g id="bee2" aria-hidden="true" stroke="#f5d687" stroke-width="1.7" fill="none">
      <!-- The stinger is at (0,0), pointing opposite the positive x direction. -->
      <path d="M0 0 L8 -2 M0 0 L8 2" />
      <path fill="#e9ae47" d="M7 0 C9 -8 26 -10 32 -4 C39 2 29 10 17 8 C10 7 7 3 7 0" />
      <path stroke="#1b2c30" stroke-width="2.6" d="M15 -7 Q12 0 15 7 M23 -7 Q20 1 23 8" />
      <g class="bee-wings" fill="#f7e7bf" fill-opacity="0.9" stroke="#f8eac9" stroke-width="1.4">
        <path d="M20 -5 C7 -11 5 -25 15 -24 C24 -23 27 -12 20 -5" />
        <path d="M22 -5 C24 -18 38 -25 40 -17 C42 -9 31 -4 22 -5" />
      </g>
      <path d="M31 -4 Q32 -12 38 -13 M30 -5 Q26 -13 30 -16" />
      <path stroke="#1b2c30" d="M32 0 L32.6 0" stroke-width="2.5" />
