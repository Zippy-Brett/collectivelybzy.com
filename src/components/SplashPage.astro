---
// Render one SplashPage per page. Requires: npm install gsap
---

<div class="bzy-splash" data-bzy-splash data-bzy-splash-force={Astro.url.pathname === '/splash-preview/'} hidden role="region" aria-label="Collectively Bzy introduction">
  <div class="bzy-splash__wash" aria-hidden="true"></div>
<svg class="bzy-splash__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600"
  fill="none" stroke-linecap="round" stroke-linejoin="round"
  role="img" aria-labelledby="bzyTitle bzyDescription">
  <title id="bzyTitle">Collectively Bzy — by ZB</title>
  <desc id="bzyDescription">A honey-gold bee with crossed ribbon wings over a slate-filled hexagon, accented with coral petals and sage leaves. Collectively Bzy is handwritten below, with by ZB centered underneath.</desc>
