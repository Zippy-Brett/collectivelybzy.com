60.00 461.90 461.00 C 469.28 453.62 482.4 414.26 478.3 405.24 C 475.02 397.04 464.36 418.36 466 430.66 C 467.64 446.24 461.08 470.02 475.02 465.1 C 479.94 463.46 483.22 457.72 486.5 461 Q484.50 461.00 486.50 463.00 C 493.06 458.9 498.8 443.32 499.62 438.4 C 497.16 451.52 494.7 465.46 502.08 466.28 C 511.1 467.92 519.3 447.42 521.76 438.4 C 517.66 454.8 513.56 471.2 507.82 487.6 C 500.44 508.1 482.4 498.26 493.88 485.96 C 507 471.2 522.58 469.56 530.78 463 C 538.98 466.28 548.82 467.1 559.48 463 C 566.04 450.7 571.78 423.64 577.52 408.88 C 575.06 418.72 570.14 446.6 566.04 465.46 C 568.5 444.96 571.78 423.64 577.52 411.34 C 587.36 400.68 612.78 403.96 613.6 420.36 C 614.42 434.3 591.46 440.86 573.42 442.5 C 589 435.12 615.24 438.4 612.78 455.62 C 610.32 470.38 585.72 475.3 569.32 466.28 C 589 471.2 610.32 467.92 620.98 463 Q618.98 463.00 620.98 462.00 C 630 457.08 635.74 439.04 644.76 439.04 C 654.6 439.86 657.06 443.96 649.68 450.52 L 634.92 466.1 C 646.4 461.18 661.98 460.36 661.98 470.2 C 660.34 484.96 645.58 493.98 637.38 486.6 C 632.46 480.04 647.22 471.84 657.88 466.1 C 661.16 464.46 663.62 462.82 666.9 462 Q664.90 462.00 666.90 463.00 C 673.46 458.9 679.2 443.32 680.02 438.4 C 677.56 451.52 675.1 465.46 682.48 466.28 C 691.5 467.92 699.7 447.42 702.16 438.4 C 698.06 454.8 693.96 471.2 688.22 487.6 C 680.84 508.1 662.8 498.26 674.28 485.96 C 687.4 471.2 702.98 469.56 711.18 463" />
    <path id="textDetailsPath" stroke-width="3.5" d="M 323.32 440.22 Q 336.44 436.12 347.92 437.76         M 363.5 427.74 L 364.32 426.92" />
  </g>
  <path id="subTextPath" stroke="#edc463" stroke-width="2.7" d="M324.375 550 C 329.88 539 338.12 514.8 335.38 510.95 C 331.52 506.55 324.93 523.05 328.23 531.3 C 331.52 538.45 341.43 530.2 343.62 537.9 C 346.93 546.7 335.93 554.95 331.52 551.1 C 334.27 545.6 338.68 541.2 342.52 540.1 C 344.18 545.05 346.38 548.9 349.68 550 Q347.68 550.00 349.68 549.00 C 354.07 546.25 357.93 535.8 358.48 532.5 C 356.82 541.3 355.18 550.65 360.12 551.2 C 366.18 552.3 371.68 538.55 373.32 532.5 C 370.57 543.5 367.82 554.5 363.98 565.5 C 359.03 579.25 346.93 572.65 354.62 564.4 C 363.43 554.5 373.88 553.4 379.38 549 C382.8 550.4 385.5 550.5 389 549 M400.5 521 C410 516.5 422 521.5 434.38 519 L403.5 548 C412.5 546.5 424 553 434.38 549 Q432.38 549.00 434.38 551.00 C 438.77 542.75 442.62 524.6 446.48 514.7 C 444.82 521.3 441.52 540 438.77 552.65 C 440.43 538.9 442.62 524.6 446.48 516.35 C 453.07 509.2 470.12 511.4 470.68 522.4 C 471.23 531.75 455.82 536.15 443.73 537.25 C 454.18 532.3 471.77 534.5 470.12 546.05 C 468.48 555.95 451.98 559.25 440.98 553.2 C 454.18 556.5 468.48 554.3 475.62 551" />
  <g id="flightHeads" visibility="hidden">

    <g id="bee1" aria-hidden="true" stroke="#f5d687" stroke-width="1.7" fill="none">
