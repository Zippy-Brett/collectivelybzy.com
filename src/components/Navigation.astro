---
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/apps/', label: 'Apps' },
  { href: '/games/', label: 'Play' },
  { href: '/projects/', label: 'Projects' },
  { href: '/specials/', label: 'Store' },
  { href: '/support/', label: 'Support' },
];
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Collectively Bzy home">
      <img class="brand-mark" src="/images/collectively-bzy-bee.png" alt="" aria-hidden="true" />
      <span class="brand-lockup">
        <span class="brand-name">Collectively Bzy</span>
        <span class="brand-byline">by ZB</span>
      </span>
    </a>
    <nav class="main-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <details class="mobile-menu"><summary>Menu <span aria-hidden="true">＋</span></summary><nav aria-label="Mobile navigation">{navItems.map(item => <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav></details>
  </div>
</header>
