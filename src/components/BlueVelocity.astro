<section class="run-shell" aria-label="Blue Velocity dolphin game">
  <div class="game-topline"><span><i></i> PELAGIC CIRCUIT <b>01</b></span><span>NEW COURSE · RUN <b id="run-seed">—</b></span></div>
  <div class="game-frame" id="blue-game">
    <canvas id="ocean-canvas" aria-label="Top-down dolphin game with a marked ocean course, hazards and a trailing wake"></canvas>
    <div class="game-vignette"></div>
    <div class="hud">
      <div class="hud-readout"><small>COURSE DISTANCE</small><strong><span id="distance">0</span><em>m</em></strong></div>
      <div class="hud-score"><small>RUN SCORE</small><strong id="score">000000</strong><div class="tail-readout" id="tail-length">WAKE 20 M</div></div>
      <div class="hud-readout speed-readout"><small>SWIM SPEED</small><strong><span id="speed">0</span><em>km/h</em></strong></div>
    </div>
    <div class="message" id="game-message"><div class="message-stamp">A LIVING COURSE THROUGH THE BLUE</div><h2>Follow the<br />current.</h2><p>Steer through the marked reef passage. Fishing nets and loose ropes can tangle you. Your own wake can catch you too.</p><button class="launch" id="start-run">SWIM THE COURSE <span>↗</span></button><div class="best-line">BEST DISTANCE <b id="best-distance">0 M</b></div></div>
    <div class="toast" id="toast" aria-live="polite"></div>
    <div class="tangle-flash" id="tangle-flash"></div>
  </div>
  <div class="game-controls">
    <div class="steer-group"><button class="control steer" data-turn="left" aria-label="Turn left">↶</button><button class="control steer" data-turn="right" aria-label="Turn right">↷</button><span>TURN</span></div>
    <div class="control-hint"><b>A / D</b> <span>TURN</span><b>W / S</b> <span>BOOST / BRAKE</span><b>SPACE</b> <span>TAIL FLICK</span><b class="pad-hint">PAD: L STICK · A FLICK · RT / LT PACE</b></div>
    <div class="pace-group"><button class="control flick" data-action="flick">TAIL FLICK</button><button class="control pace" data-hold="brake"><span>−</span> BRAKE</button><button class="control boost" data-hold="boost"><span>↗</span> BOOST</button></div>
  </div>
  <div class="run-foot"><span>THE REEF MARKS THE COURSE. THE WAKE REMEMBERS YOUR PATH.</span><span>NET OR WAKE = TANGLED <b>✳</b></span></div>
</section>

<script>
  import '../scripts/blue-velocity.js';
</script>

<style>
  .run-shell{--ink:#e3f7f0;--lime:#d8fb78;color:var(--ink);background:#061f2d;border:1px solid rgba(188,239,222,.16);border-radius:24px;overflow:hidden;box-shadow:0 30px 90px #04172055;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
  .game-topline,.run-foot{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;color:#94b9b8;font-size:9px;font-weight:800;letter-spacing:.15em}.game-topline i{display:inline-block;width:7px;height:7px;margin-right:8px;background:var(--lime);border-radius:50%;box-shadow:0 0 12px var(--lime)}.game-topline b{color:var(--lime)}
  .game-frame{position:relative;isolation:isolate;aspect-ratio:16/8.5;min-height:400px;overflow:hidden;background:#075168}.game-frame canvas,.game-vignette{position:absolute;inset:0;width:100%;height:100%}.game-vignette{z-index:1;pointer-events:none;background:linear-gradient(180deg,#03192344,transparent 18%,transparent 84%,#041d2c55),radial-gradient(ellipse at center,transparent 45%,#041b2a44 100%)}
  .hud{position:absolute;z-index:2;inset:18px 22px auto;display:grid;grid-template-columns:1fr 1fr 1fr;pointer-events:none}.hud-readout small,.hud-score small{display:block;color:#b3d3c9;font-size:8px;letter-spacing:.2em}.hud-readout strong,.hud-score strong{display:block;margin-top:5px;font-size:clamp(17px,2.4vw,27px);letter-spacing:-.07em;font-family:ui-monospace,monospace}.hud-readout em{font-size:9px;font-style:normal;color:#c1ded2;letter-spacing:0}.hud-score{text-align:center}.hud-score strong{color:var(--lime);letter-spacing:.12em;font-size:17px}.speed-readout{text-align:right}.tail-readout{margin-top:5px;color:#b7d4c6;font-size:7px;letter-spacing:.15em}
  .message{position:absolute;z-index:3;top:50%;left:50%;width:min(410px,85%);padding:32px 38px;transform:translate(-50%,-45%);background:#061f2ddd;border:1px solid #d1f9e344;box-shadow:0 20px 80px #001c28aa;backdrop-filter:blur(13px);transition:opacity .3s,transform .3s}.message.hidden{opacity:0;transform:translate(-50%,-40%);pointer-events:none}.message-stamp{font-size:8px;color:var(--lime);letter-spacing:.2em}.message h2{font-family:Georgia,serif;font-size:clamp(38px,6vw,62px);line-height:.86;letter-spacing:-.07em;margin:20px 0 12px;color:#f1fff5}.message p{font-family:ui-sans-serif,system-ui,sans-serif;font-size:13px;line-height:1.6;color:#bad5d0;max-width:280px}.launch{border:0;border-radius:2px;margin-top:12px;padding:13px 17px;background:var(--lime);color:#102b30;font:900 10px ui-monospace,monospace;letter-spacing:.13em;cursor:pointer}.launch span{margin-left:18px;font-size:15px}.launch:hover{background:#edffb8}.best-line{display:flex;justify-content:space-between;border-top:1px solid #c7f3df33;margin-top:22px;padding-top:14px;font-size:8px;letter-spacing:.15em;color:#a8c8bf}.best-line b{color:#e9ffe7}.toast{position:absolute;z-index:3;top:24%;left:50%;transform:translate(-50%,-50%);font-size:11px;letter-spacing:.15em;font-weight:900;color:var(--lime);text-shadow:0 2px 15px #00202b;opacity:0;transition:opacity .2s;pointer-events:none;white-space:nowrap}.toast.show{opacity:1}.tangle-flash{position:absolute;z-index:2;inset:0;pointer-events:none;opacity:0;background:radial-gradient(ellipse,#ff756733,#ff4d3311 65%,transparent 100%);transition:opacity .12s}.tangle-flash.show{opacity:1}
  .game-controls{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 18px;background:#092b39}.control{height:40px;border:1px solid #a8d4c532;background:#0e3947;color:#e9fff4;font:800 9px ui-monospace,monospace;letter-spacing:.1em;cursor:pointer;touch-action:none}.control:active,.control.active{background:#1b5960;color:var(--lime);border-color:#d8fb7880}.control span{font-size:14px;vertical-align:-1px;margin-right:5px}.steer-group,.pace-group{display:flex;align-items:center;gap:6px}.steer{width:43px;font-size:18px}.steer-group>span{margin-left:5px;font-size:8px;color:#80aaa8;letter-spacing:.15em}.flick{padding:0 11px;color:var(--lime)}.pace{padding:0 11px}.boost{padding:0 14px;background:var(--lime);color:#102b30;border-color:var(--lime)}.boost:active,.boost.active{background:#f1ffbd;color:#102b30}.control-hint{display:flex;align-items:center;gap:7px;color:#d5ece4;font-size:8px;letter-spacing:.05em}.control-hint b{font-size:9px;white-space:nowrap}.control-hint span{color:#81aaa6;margin-right:8px;white-space:nowrap}.pad-hint{color:#bedcce!important}.run-foot{font-size:8px;padding:12px 20px;border-top:1px solid #b9e3d21a}.run-foot b{color:var(--lime);font-size:13px}
  @media(max-width:760px){.game-frame{aspect-ratio:4/5;min-height:480px}.game-topline,.run-foot{padding-inline:12px;font-size:7px}.hud{inset:14px 13px auto}.game-controls{padding:12px 9px;flex-wrap:wrap;justify-content:space-between}.control-hint{order:3;width:100%;justify-content:center;flex-wrap:wrap;line-height:1.7}.steer-group>span{display:none}.steer{width:40px}.control{height:42px}.flick{padding:0 8px}.pace{padding:0 8px}.boost{padding:0 10px}.message{padding:26px 25px}}
</style>
