# Storyblok space. Do not put personal or management tokens in this file.
STORYBLOK_SPACE_ID=295535334209633
STORYBLOK_API_BASE_URL=https://api.storyblok.com
STORYBLOK_PUBLIC_TOKEN=
STORYBLOK_PREVIEW_TOKEN=
# Use draft + the space-scoped Preview token for local editing.
# Use published + the space-scoped Public token for a production build.
STORYBLOK_VERSION=published

# Existing Sanity fallback. Keep this until Storyblok is tested and approved.
# Published content should be queried read-only.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Draft builds must opt in AND exclude search indexing.
STORYBLOK_PREVIEW_BUILD=false
SITE_INDEXABLE=true
# Leave empty for authoritative Storyblok. Temporary migration only: merge.
STORYBLOK_MIGRATION_MODE=
